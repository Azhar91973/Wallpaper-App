<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CornerCut" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10%</item>
    </style>
    <style name="menuItemStyle" parent="TextAppearance.AppCompat.Body1">
        <item name="fontFamily">@font/poppins_regular</item>
    </style>
    <style name="TextHeading">
        <item name="android:textSize">@dimen/text_heading</item>
        <item name="android:textColor">@color/primary_color</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Subheading Text Style -->
    <style name="TextSubheading">
        <item name="android:textSize">@dimen/text_subheading</item>
        <item name="android:textColor">@color/light_grey</item>
        <item name="android:textAlignment">center</item>
    </style>

    <!-- Input Field Style -->
    <style name="InputField">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/input_height</item>
        <item name="android:background">@drawable/input_background</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_tertiary</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Primary Button Style -->
    <style name="PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:background">@drawable/button_gradient_primary</item>
        <item name="android:textColor">@color/text_white</item>
        <item name="android:textSize">@dimen/text_button</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">@dimen/button_elevation</item>
        <item name="android:stateListAnimator">@anim/button_scale</item>
    </style>

    <!-- Text Link Style -->
    <style name="TextLink">
        <item name="android:textSize">@dimen/text_link</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:background">?attr/selectableItemBackground</item>
    </style>

    <!-- Secondary Text Style -->
    <style name="TextSecondary">
        <item name="android:textSize">@dimen/text_link</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
</resources>